# Copie os NOMES, nunca os valores. Os valores reais vivem no Environment do
# Dokploy — este arquivo e o repositorio sao publicos.

PORT=8080
DATA_DIR=/app/data

# Endereco publico de cada dominio. O QR code e o texto da tela de projecao saem
# daqui, entao trocar de dominio e trocar so estas duas linhas.
URL_ENQUETE=https://enquete.lexcode.tech
URL_LINKS=https://links.lexcode.tech

# Autoriza POST /api/admin/reset (zera as respostas entre turmas).
# Gere um valor aleatorio proprio; sem ele a rota fica desligada.
ADMIN_TOKEN=troque-por-um-valor-aleatorio
